rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.email is string &&
             data.email.size() <= 254 &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 120 &&
             data.accountType in ['google_personal', 'school_workspace'] &&
             data.proActive is bool &&
             data.completedModuleIds is list &&
             data.completedModuleIds.size() <= 50 &&
             (data.completedModuleIds.size() == 0 || data.completedModuleIds[0] is string) &&
             data.dailyPromptsUsed is int &&
             data.dailyPromptsUsed >= 0 &&
             data.dailyPromptsUsed <= 10000 &&
             data.promptDate is string &&
             data.promptDate.size() == 10 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidCloudDeck(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 160 &&
             data.subtitle is string &&
             data.subtitle.size() <= 300 &&
             data.audience is string &&
             data.audience.size() >= 1 &&
             data.audience.size() <= 80 &&
             data.themeName in ['MINIMALIST_TECH', 'CLEAN_ACADEMIC', 'DARK_NEON', 'EXECUTIVE_PITCH'] &&
             data.aiGenerated is bool &&
             data.slides is list &&
             data.slides.size() >= 1 &&
             data.slides.size() <= 15 &&
             data.slides[0] is map &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'email', 'displayName', 'accountType',
                         'proActive', 'completedModuleIds', 'dailyPromptsUsed',
                         'promptDate', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'email', 'displayName', 'accountType',
                         'proActive', 'completedModuleIds', 'dailyPromptsUsed',
                         'promptDate', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'email', 'displayName', 'accountType', 'updatedAt'
                         ]) ||
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'proActive', 'updatedAt'
                         ]) ||
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'completedModuleIds', 'updatedAt'
                         ]) ||
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'dailyPromptsUsed', 'promptDate', 'updatedAt'
                         ])
                       );

      allow delete: if isOwner(userId) && isValidId(userId);

      match /decks/{deckId} {
        allow get: if isOwner(userId) && isValidId(deckId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(deckId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'subtitle', 'audience',
                           'themeName', 'aiGenerated', 'slides',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'subtitle', 'audience',
                           'themeName', 'aiGenerated', 'slides',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidCloudDeck(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(deckId) &&
                         isValidCloudDeck(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'subtitle', 'audience', 'themeName', 'slides', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(deckId);
      }
    }
  }
}
